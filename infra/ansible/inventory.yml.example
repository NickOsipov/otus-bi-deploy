all:
  children:
    docker_hosts:
      hosts:
        metabase:
          ansible_host: {{ metabase_ip }}
          ansible_user: {{ ansible_user }}
          ansible_ssh_private_key_file: {{ ssh_key_path }}
        redash:
          ansible_host: {{ redash_ip }}
          ansible_user: {{ ansible_user }}
          ansible_ssh_private_key_file: {{ ssh_key_path }}
        superset:
          ansible_host: {{ redash_ip }}
          ansible_user: {{ ansible_user }}
          ansible_ssh_private_key_file: {{ ssh_key_path }}